# Copy to .env (gitignored) — or let the Setup page / `job-pipeline auth`
# write it for you. Read at startup; values here win over shell variables.

# How the pipeline talks to Claude:
#   api_key     — an Anthropic API key (default, recommended)
#   claude_code — your own locally logged-in Claude Code CLI (personal use only)
JOB_PIPELINE_AUTH_MODE=api_key

# Needed for api_key mode. Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# claude_code mode only, optional: full path to the `claude` binary if it
# isn't on your PATH.
CLAUDE_CLI_PATH=
# claude_code mode only, optional: a long-lived token from `claude setup-token`,
# so the CLI doesn't need an interactive /login.
CLAUDE_CODE_OAUTH_TOKEN=

# OPTIONAL: JSearch open-web job search (RapidAPI — Google for Jobs).
# Free tier ≈ 200 requests/month: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=

# OPTIONAL: keep your profile somewhere other than ./profile
# JOB_PIPELINE_PROFILE_DIR=

# Monthly Claude spending budget in USD (0 = none) and what happens when it's
# reached: "warn" or "stop". Also settable on the Privacy & spending page.
JOB_PIPELINE_MONTHLY_BUDGET=0
JOB_PIPELINE_BUDGET_MODE=warn
